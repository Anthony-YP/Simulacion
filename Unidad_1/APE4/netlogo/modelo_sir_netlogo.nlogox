<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;; Modelo SIR en NetLogo + integración con los CSV de Python y Java.
;; Mismos parámetros y misma regla que en Python/SimPy y Java.

extensions [ csv ]

globals [
  datos-netlogo   ;; filas [tiempo susceptibles infectados recuperados] simuladas aquí
  datos-python    ;; filas leídas de resultados_python.csv
  datos-java      ;; filas leídas de resultados_java.csv
]

turtles-own [
  estado          ;; "S", "I" o "R"
  estado-previo   ;; copia del estado al inicio del paso
]

;;; ---------------------------------------------------------------------------
;;; Parte 1: simulación SIR en NetLogo
;;; ---------------------------------------------------------------------------

to setup
  ;; No se usa clear-all para no borrar los CSV que ya se hayan cargado.
  clear-turtles
  clear-patches
  clear-ticks
  random-seed semilla
  set datos-netlogo []
  set-default-shape turtles "circle"
  create-turtles poblacion [
    setxy random-xcor random-ycor
    set estado "S"
  ]
  ask n-of infectados-iniciales turtles [ set estado "I" ]
  ask turtles [ colorear ]
  reset-ticks
  registrar
end

to go
  if ticks >= tiempo-max [ stop ]
  paso
  tick
  registrar
end

;; Un paso de tiempo, igual que el pseudocódigo de la guía.
to paso
  ;; Copia del estado actual: los cambios del paso se deciden sobre ella.
  ask turtles [ set estado-previo estado ]
  ask turtles with [ estado-previo = "I" ] [
    ;; Cada infectado elige un contacto al azar y, si era susceptible,
    ;; lo contagia con probabilidad beta.
    let contacto one-of other turtles
    if [ estado-previo ] of contacto = "S" and random-float 1 < beta [
      ask contacto [ set estado "I" ]
    ]
    ;; Después se recupera con probabilidad gamma.
    if random-float 1 < gamma [ set estado "R" ]
  ]
  ask turtles [
    colorear
    rt random 360
    fd 0.5   ;; solo visual: los contactos son al azar en toda la población
  ]
end

to colorear
  set color ifelse-value estado = "S" [ green ] [ ifelse-value estado = "I" [ red ] [ gray ] ]
end

;; Guarda S, I y R del tick actual y actualiza las gráficas de NetLogo.
to registrar
  set datos-netlogo lput (list ticks
                               count turtles with [ estado = "S" ]
                               count turtles with [ estado = "I" ]
                               count turtles with [ estado = "R" ]) datos-netlogo
  dibujar-fuente "NetLogo" "SIR NetLogo" datos-netlogo
end

;;; ---------------------------------------------------------------------------
;;; Parte 3: integración Python/Java -> NetLogo (NetLogo solo lee y grafica)
;;; ---------------------------------------------------------------------------

to cargar-python
  set datos-python leer-csv "resultados_python.csv"
  dibujar-fuente "Python" "Python (SimPy)" datos-python
end

;; Abre el CSV, lee el encabezado, lee cada fila y cierra el archivo.
;; El archivo debe estar en la misma carpeta que este modelo.
to-report leer-csv [ archivo ]
  if not file-exists? archivo [
    user-message (word "No se encontró " archivo ". Cópialo en la misma carpeta que este modelo.")
    report []
  ]
  let filas []
  file-open archivo
  let encabezado csv:from-row file-read-line
  if encabezado != [ "tiempo" "susceptibles" "infectados" "recuperados" ] [
    file-close
    user-message (word archivo ": la cabecera debe ser tiempo,susceptibles,infectados,recuperados")
    report []
  ]
  while [ not file-at-end? ] [
    let fila csv:from-row file-read-line
    if length fila = 4 [ set filas lput fila filas ]
  ]
  file-close
  report filas
end

;;; ---------------------------------------------------------------------------
;;; Gráficas y monitores
;;; ---------------------------------------------------------------------------

;; Dibuja una fuente (NetLogo, Python o Java) en su gráfica propia
;; y en las tres gráficas de comparación.
to dibujar-fuente [ fuente grafica datos ]
  dibujar grafica "Susceptibles" datos 1
  dibujar grafica "Infectados" datos 2
  dibujar grafica "Recuperados" datos 3
  dibujar "Comparación susceptibles" fuente datos 1
  dibujar "Comparación infectados" fuente datos 2
  dibujar "Comparación recuperados" fuente datos 3
end

to dibujar [ grafica pluma datos columna ]
  set-current-plot grafica
  set-current-plot-pen pluma
  plot-pen-reset
  foreach datos [ fila -> plotxy item 0 fila item columna fila ]
end

to-report pico-infectados [ datos ]
  if not is-list? datos or empty? datos [ report "-" ]
  report max map [ fila -> item 2 fila ] datos
end

to-report recuperados-final [ datos ]
  if not is-list? datos or empty? datos [ report "-" ]
  report item 3 last datos
end]]></code>
