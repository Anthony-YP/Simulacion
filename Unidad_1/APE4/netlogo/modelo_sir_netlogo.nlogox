    <monitor x="301" precision="0" y="340" height="60" fontSize="11" width="100" display="Pico I Python">pico-infectados datos-python</monitor>
    <monitor x="387" precision="0" y="340" height="60" fontSize="11" width="100" display="Pico I Java">pico-infectados datos-java</monitor>
    <monitor x="215" precision="0" y="408" height="60" fontSize="11" width="100" display="R final NetLogo">recuperados-final datos-netlogo</monitor>
    <monitor x="301" precision="0" y="408" height="60" fontSize="11" width="100" display="R final Python">recuperados-final datos-python</monitor>
    <monitor x="387" precision="0" y="408" height="60" fontSize="11" width="100" display="R final Java">recuperados-final datos-java</monitor>
